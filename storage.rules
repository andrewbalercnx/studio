// Storage rules v2 - Production-hardened
// - Removed isServer() function (Admin SDK bypasses rules entirely)
// - Child photos restricted to owner + admin (no longer public)
// - Added file size limits on uploads
// - Added content type validation
// - Photos are written by the routes only (slice 5.7b); this is the only storage rules file
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && request.auth.token.isAdmin == true;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function storyOwnedByParent(storyId) {
      return request.auth != null
          && firestore.get(/databases/(default)/documents/stories/$(storyId)).data.parentUid == request.auth.uid;
    }

    // By default, deny all reads and writes.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Child and Character photos (slice 5.7b): uploaded through the
    // `/api/{children,characters}/{id}/photos` routes (Admin SDK) only; the
    // owner may read them.
    match /users/{parentUid}/{kind}/{personId}/photos/{fileName} {
      allow read: if isAdmin()
                  || (isAuthenticated() && request.auth.uid == parentUid && kind in ['children', 'characters']);
      allow write: if false;
    }

    // Story assets - owner or admin
    match /stories/{storyId}/{restOfPath=**} {
      allow read: if isAdmin() || storyOwnedByParent(storyId);
      allow write: if isAdmin() || storyOwnedByParent(storyId);
    }

    // Storybook printables - owner can read, only admin can write
    match /storybook_printables/{storyId}/{restOfPath=**} {
      allow read: if isAdmin() || storyOwnedByParent(storyId);
      allow write: if isAdmin();
    }
  }
}
